<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EatTogether.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:auth="clr-namespace:EatTogether.MAUI.Views.Auth"
    xmlns:main="clr-namespace:EatTogether.MAUI.Views.Main"
    xmlns:family="clr-namespace:EatTogether.MAUI.Views.Main.FamilyPages"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">


    <ShellContent Route="SignInPage" ContentTemplate="{DataTemplate auth:SignInPage}"/>
    <ShellContent Route="SignUpPage" ContentTemplate="{DataTemplate auth:SignUpPage}"/>
    <ShellContent Route="ProfilePage" ContentTemplate="{DataTemplate main:ProfilePage}"/>
    <ShellContent Route="MainPage" ContentTemplate="{DataTemplate main:MainPage}"/>
    <ShellContent Route="FamilyPage" ContentTemplate="{DataTemplate main:FamilyPage}"/>
    <ShellContent Route="MenuPage" ContentTemplate="{DataTemplate main:MenuPage}"/>
    <ShellContent Route="CreateFamilyPage" ContentTemplate="{DataTemplate family:CreateFamilyPage}"/>


</Shell>
