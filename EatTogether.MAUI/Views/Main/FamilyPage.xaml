<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EatTogether.MAUI.Views.Main.FamilyPage"
             xmlns:vm="clr-namespace:EatTogether.MAUI.ViewModels"
             xmlns:converters="clr-namespace:EatTogether.MAUI.Converters"
             xmlns:models="clr-namespace:EatTogether.MAUI.Models"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}">

    <ContentPage.BindingContext>
        <vm:FamilyViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TabTextColorConverter x:Key="TabTextColorConverter"/>
            <converters:TabIndicatorMarginConverter x:Key="TabIndicatorMarginConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:FirstCharacterConverter x:Key="FirstCharacterConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView x:Name="MainScrollView"
                Scrolled="OnScrollViewScrolled">

        <VerticalStackLayout Padding="20" Spacing="24">

            <!-- Добавляем GestureRecognizers для свайпа -->
            <VerticalStackLayout.GestureRecognizers>
                <SwipeGestureRecognizer Direction="Left" Command="{Binding SwipeLeftCommand}"/>
                <SwipeGestureRecognizer Direction="Right" Command="{Binding SwipeRightCommand}"/>
            </VerticalStackLayout.GestureRecognizers>

            <!-- Контент когда ЕСТЬ семья -->
            <VerticalStackLayout IsVisible="{Binding HasFamily}" Spacing="24">

                <!-- Основная карточка семьи -->
                <Frame Padding="20"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                       CornerRadius="16"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="16">
                        <!-- Заголовок карточки -->
                        <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                            <Label Text="Информация о семье"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                   HorizontalOptions="StartAndExpand"/>

                            <Button Text="Редактировать"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource PrimaryColor}"
                                    FontSize="12"
                                    BorderWidth="1"
                                    BorderColor="{StaticResource PrimaryColor}"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    HeightRequest="30"/>
                        </HorizontalStackLayout>

                        <!-- Основная информация -->
                        <HorizontalStackLayout Spacing="16">
                            <!-- Аватар -->
                            <Frame WidthRequest="80"
                                   HeightRequest="80"
                                   CornerRadius="40"
                                   BackgroundColor="{StaticResource PrimaryColor}"
                                   Padding="0"
                                   HasShadow="True">
                                <Label Text="И"
                                       TextColor="White"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Информация -->
                            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding FamilyName}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                <HorizontalStackLayout Spacing="8">
                                    <Frame BackgroundColor="{StaticResource PrimaryColor}" 
                                           CornerRadius="10" 
                                           Padding="8,4"
                                           HeightRequest="20">
                                        <Label Text="{Binding MembersCount}"
                                               FontSize="10"
                                               TextColor="White"
                                               FontAttributes="Bold"/>
                                    </Frame>

                                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" 
                                           CornerRadius="10" 
                                           Padding="8,4"
                                           HeightRequest="20">
                                        <Label Text="Активна"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Описание семьи -->
                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                               CornerRadius="12"
                               Padding="16"
                               BorderColor="Transparent">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="О нашей семье"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                                <Label Text="{Binding FamilyDescription}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                       MaxLines="3"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Панель вкладок - ДИНАМИЧЕСКАЯ ВЫСОТА -->
                <Frame Padding="0"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                       CornerRadius="16"
                       HasShadow="True">

                    <VerticalStackLayout Spacing="0">
                        <!-- Заголовок панели вкладок -->
                        <Border Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1">
                            <Grid Padding="20,16" ColumnDefinitions="*,Auto">
                                <Label Text="Управление семьей"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                       VerticalOptions="Center"/>

                                <Button Text="Пригласить"
                                        Grid.Column="1"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        TextColor="White"
                                        FontSize="12"
                                        CornerRadius="8"
                                        Padding="16,8"
                                        HeightRequest="32"/>
                            </Grid>
                        </Border>

                        <!-- Переключатель вкладок -->
                        <Grid ColumnDefinitions="*,*,*" 
                              ColumnSpacing="0" 
                              HeightRequest="48"
                              Padding="8,0">

                            <!-- Activity Tab -->
                            <Button Text="Активность"
                                    Grid.Column="0"
                                    BackgroundColor="Transparent"
                                    TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabTextColorConverter}, ConverterParameter=0}"
                                    CornerRadius="6"
                                    BorderWidth="0"
                                    FontSize="14"
                                    Command="{Binding SelectTabCommand}"
                                    CommandParameter="0"/>

                            <!-- Members Tab -->
                            <Button Text="Участники"
                                    Grid.Column="1"
                                    BackgroundColor="Transparent"
                                    TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabTextColorConverter}, ConverterParameter=1}"
                                    CornerRadius="6"
                                    BorderWidth="0"
                                    FontSize="14"
                                    Command="{Binding SelectTabCommand}"
                                    CommandParameter="1"/>

                            <!-- Requests Tab -->
                            <Button Text="Запросы"
                                    Grid.Column="2"
                                    BackgroundColor="Transparent"
                                    TextColor="{Binding SelectedTabIndex, Converter={StaticResource TabTextColorConverter}, ConverterParameter=2}"
                                    CornerRadius="6"
                                    BorderWidth="0"
                                    FontSize="14"
                                    Command="{Binding SelectTabCommand}"
                                    CommandParameter="2"/>
                        </Grid>

                        <!-- Индикатор активной вкладки -->
                        <BoxView HeightRequest="3"
                                 WidthRequest="80"
                                 BackgroundColor="{StaticResource PrimaryColor}"
                                 HorizontalOptions="Start"
                                 Margin="{Binding SelectedTabIndex, Converter={StaticResource TabIndicatorMarginConverter}}"
                                 VerticalOptions="End"/>

                        <!-- Контент вкладок - ВЫСОТА ПОДСТРАИВАЕТСЯ -->
                        <CarouselView ItemsSource="{Binding Tabs}"
                                      CurrentItem="{Binding CurrentTab}"
                                      Loop="False"
                                      PeekAreaInsets="0"
                                      HorizontalScrollBarVisibility="Never"
                                      HorizontalOptions="FillAndExpand"
                                      HeightRequest="{Binding CurrentTabHeight}">

                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TabItem">
                                    <Grid>

                                        <!-- АКТИВНОСТЬ - ТАРЕЛКИ -->
                                        <VerticalStackLayout IsVisible="{Binding IsActivity}" 
                                                             Spacing="16"
                                                             Padding="20,16,20,40">

                                            <!-- Индикатор загрузки тарелок -->
                                            <ActivityIndicator IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                   Path=BindingContext.IsLoadingPlates}"
                                                               IsRunning="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                   Path=BindingContext.IsLoadingPlates}"
                                                               Color="{StaticResource PrimaryColor}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>

                                            <!-- Сообщение когда нет тарелок -->
                                            <Frame IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                       Path=BindingContext.HasPlates, 
                                                                       Converter={StaticResource InvertedBoolConverter}}"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                   CornerRadius="12"
                                                   Padding="20">
                                                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                                                    <Label Text="🍽️"
                                                           FontSize="32"
                                                           HorizontalOptions="Center"/>

                                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                                        <Label Text="Пока нет заявок на блюда"
                                                               FontSize="16"
                                                               FontAttributes="Bold"    
                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                               HorizontalOptions="Center"/>

                                                        <Label Text="Здесь будут отображаться заявки на приготовление блюд от участников семьи"
                                                               FontSize="14"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                                               HorizontalOptions="Center"
                                                               HorizontalTextAlignment="Center"/>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- СПИСОК ТАРЕЛОК -->
                                            <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                  Path=BindingContext.Plates}"
                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                Path=BindingContext.HasPlates}"
                                                            SelectionMode="None"
                                                            VerticalOptions="FillAndExpand">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Plate">
                                                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                                               BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                                                               CornerRadius="12"
                                                               Padding="0"
                                                               Margin="0,0,0,12"
                                                               HasShadow="True">

                                                            <VerticalStackLayout Spacing="0">
                                                                <!-- ШАПКА ТАРЕЛКИ -->
                                                                <Grid Padding="16"
                                                                      ColumnDefinitions="Auto,*,Auto"
                                                                      ColumnSpacing="12">

                                                                    <!-- Аватар пользователя -->
                                                                    <Frame WidthRequest="40"
                                                                           HeightRequest="40"
                                                                           CornerRadius="20"
                                                                           BackgroundColor="{StaticResource PrimaryColor}"
                                                                           Padding="0"
                                                                           VerticalOptions="Center">
                                                                        <Label Text="{Binding UserInitial}"
                                                                               TextColor="White"
                                                                               FontSize="14"
                                                                               FontAttributes="Bold"
                                                                               HorizontalOptions="Center"
                                                                               VerticalOptions="Center"/>
                                                                    </Frame>

                                                                    <!-- Информация о пользователе -->
                                                                    <VerticalStackLayout Grid.Column="1" 
                                                                                         Spacing="4" 
                                                                                         VerticalOptions="Center">
                                                                        <Label Text="{Binding UserName}"
                                                                               FontSize="14"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                                                        <Label Text="Заявка на приготовление"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                                                                    </VerticalStackLayout>

                                                                    <!-- Статус и кнопка раскрытия -->
                                                                    <HorizontalStackLayout Grid.Column="2" 
                                                                                           Spacing="8" 
                                                                                           VerticalOptions="Center">

                                                                        <!-- Статус тарелки -->
                                                                        <Frame BackgroundColor="{Binding StatusColor}"
                                                                               CornerRadius="6"
                                                                               Padding="6,2"
                                                                               HeightRequest="24"
                                                                               MinimumWidthRequest="60">
                                                                            <Label Text="{Binding StatusText}"
                                                                                   FontSize="10"
                                                                                   TextColor="White"
                                                                                   FontAttributes="Bold"
                                                                                   HorizontalOptions="Center"/>
                                                                        </Frame>

                                                                        <!-- Кнопка раскрытия/скрытия -->
                                                                        <Button BackgroundColor="Transparent"
                                                                                Padding="0"
                                                                                WidthRequest="32"
                                                                                HeightRequest="32"
                                                                                CornerRadius="16"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                                  Path=BindingContext.TogglePlateCommand}"
                                                                                CommandParameter="{Binding Id}">
                                                                            <Button.ImageSource>
                                                                                <FontImageSource Glyph="{Binding IsExpanded, 
                                                                                                                 Converter={StaticResource ExpandedIconConverter}}"
                                                                                                 FontFamily="MaterialIconsOutlined"
                                                                                                 Color="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource Gray300}}"
                                                                                                 Size="20"/>
                                                                            </Button.ImageSource>
                                                                        </Button>
                                                                    </HorizontalStackLayout>
                                                                </Grid>

                                                                <!-- СОДЕРЖИМОЕ ТАРЕЛКИ (раскрывается) -->
                                                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" 
                                                                                     Spacing="0">

                                                                    <!-- Разделитель -->
                                                                    <BoxView HeightRequest="1"
                                                                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                                             Margin="16,8"/>

                                                                    <!-- Заголовок списка блюд -->
                                                                    <Label Text="Блюда в заявке:"
                                                                           FontSize="12"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                                                           Margin="16,8,16,4"/>

                                                                    <!-- Список блюд -->
                                                                    <CollectionView ItemsSource="{Binding Dishes}"
                                                                                    SelectionMode="None"
                                                                                    Margin="16,0">

                                                                        <CollectionView.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:Dish">
                                                                                <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                                                                       CornerRadius="8"
                                                                                       Padding="12"
                                                                                       Margin="0,0,0,8">

                                                                                    <Grid ColumnDefinitions="*,Auto,Auto" 
                                                                                          ColumnSpacing="8"
                                                                                          VerticalOptions="Center">

                                                                                        <!-- Название блюда -->
                                                                                        <Label Text="{Binding Name}"
                                                                                               FontSize="14"
                                                                                               FontAttributes="Bold"
                                                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                                                               VerticalOptions="Center"/>

                                                                                        <!-- Статус блюда -->
                                                                                        <Frame Grid.Column="1"
                                                                                               BackgroundColor="#FFA500"
                                                                                               CornerRadius="4"
                                                                                               Padding="6,2"
                                                                                               HeightRequest="20"
                                                                                               VerticalOptions="Center">
                                                                                            <Label Text="Ожидает"
                                                                                                   FontSize="9"
                                                                                                   TextColor="White"
                                                                                                   FontAttributes="Bold"/>
                                                                                        </Frame>

                                                                                        <!-- Кнопки действий для блюда -->
                                                                                        <HorizontalStackLayout Grid.Column="2" 
                                                                                                               Spacing="4"
                                                                                                               VerticalOptions="Center">

                                                                                            <!-- Кнопка принять -->
                                                                                            <Button Text="✓"
                                                                                                    BackgroundColor="#4CAF50"
                                                                                                    TextColor="White"
                                                                                                    FontSize="12"
                                                                                                    FontAttributes="Bold"
                                                                                                    CornerRadius="4"
                                                                                                    WidthRequest="28"
                                                                                                    HeightRequest="28"
                                                                                                    Padding="0"/>

                                                                                            <!-- Кнопка отклонить -->
                                                                                            <Button Text="✕"
                                                                                                    BackgroundColor="#F44336"
                                                                                                    TextColor="White"
                                                                                                    FontSize="12"
                                                                                                    FontAttributes="Bold"
                                                                                                    CornerRadius="4"
                                                                                                    WidthRequest="28"
                                                                                                    HeightRequest="28"
                                                                                                    Padding="0"/>
                                                                                        </HorizontalStackLayout>
                                                                                    </Grid>
                                                                                </Frame>
                                                                            </DataTemplate>
                                                                        </CollectionView.ItemTemplate>
                                                                    </CollectionView>

                                                                    <!-- Кнопки для массовых действий -->
                                                                    <Grid ColumnDefinitions="*,*"
                                                                          ColumnSpacing="8"
                                                                          Padding="16,12,16,16">

                                                                        <!-- Кнопка принять все -->
                                                                        <Button Text="ПРИНЯТЬ ВСЕ"
                                                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                                                TextColor="White"
                                                                                FontSize="12"
                                                                                FontAttributes="Bold"
                                                                                CornerRadius="8"
                                                                                HeightRequest="36"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                                  Path=BindingContext.AcceptPlateCommand}"
                                                                                CommandParameter="{Binding Id}"/>

                                                                        <!-- Кнопка отклонить все -->
                                                                        <Button Text="ОТКЛОНИТЬ ВСЕ"
                                                                                Grid.Column="1"
                                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                                                FontSize="12"
                                                                                FontAttributes="Bold"
                                                                                CornerRadius="8"
                                                                                HeightRequest="36"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                                  Path=BindingContext.RejectPlateCommand}"
                                                                                CommandParameter="{Binding Id}"/>
                                                                    </Grid>
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </Frame>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>

                                                <!-- Пустое пространство после списка -->
                                                <CollectionView.Footer>
                                                    <StackLayout HeightRequest="40"/>
                                                </CollectionView.Footer>
                                            </CollectionView>

                                            <!-- Подсказка по функционалу -->
                                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                   CornerRadius="12"
                                                   Padding="16">
                                                <VerticalStackLayout Spacing="8">
                                                    <Label Text="📋 Как работает этот раздел?"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="• Участники добавляют блюда в тарелки"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>

                                                        <Label Text="• Тарелки видны всей семье"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>

                                                        <Label Text="• Вы можете принимать/отклонять блюда"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>

                                                        <Label Text="• Статус обновляется в реальном времени"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Дополнительное пространство в конце -->
                                            <BoxView HeightRequest="30" Color="Transparent"/>
                                        </VerticalStackLayout>

                                        <!-- УЧАСТНИКИ -->
                                        <VerticalStackLayout IsVisible="{Binding IsMembers}" 
                                                             Spacing="12"
                                                             Padding="20,16,20,40">

                                            <!-- Индикатор загрузки -->
                                            <ActivityIndicator IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                   Path=BindingContext.IsLoading}"
                                                               IsRunning="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                   Path=BindingContext.IsLoading}"
                                                               Color="{StaticResource PrimaryColor}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>

                                            <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                  Path=BindingContext.FamilyMembers}"
                                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                Path=BindingContext.IsLoading, 
                                                                                Converter={StaticResource InvertedBoolConverter}}"
                                                            VerticalOptions="FillAndExpand">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FamilyMember">
                                                        <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                               CornerRadius="12"
                                                               Padding="16"
                                                               Margin="0,0,0,12">
                                                            <Grid ColumnDefinitions="Auto,1*,Auto" ColumnSpacing="12">
                                                                <!-- Аватар участника -->
                                                                <Frame WidthRequest="44"
                                                                       HeightRequest="44"
                                                                       CornerRadius="22"
                                                                       BackgroundColor="{StaticResource PrimaryColor}"
                                                                       Padding="0">
                                                                    <Label Text="{Binding DisplayName, Converter={StaticResource FirstCharacterConverter}}"
                                                                           TextColor="White"
                                                                           FontSize="16"
                                                                           FontAttributes="Bold"
                                                                           HorizontalOptions="Center"
                                                                           VerticalOptions="Center"/>
                                                                </Frame>

                                                                <!-- Информация об участнике -->
                                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                    <Label Text="{Binding DisplayName}"
                                                                           FontSize="16"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
                                                                    <Label Text="Участник"
                                                                           FontSize="12"
                                                                           TextColor="{StaticResource PrimaryColor}"/>
                                                                    <Label Text="{Binding JoinedAt, StringFormat='Участник с {0:dd.MM.yyyy}'}"
                                                                           FontSize="10"
                                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                                                                </VerticalStackLayout>

                                                                <!-- Блок с действиями -->
                                                                <Grid Grid.Column="2" 
                                                                      ColumnDefinitions="Auto,Auto" 
                                                                      ColumnSpacing="8"
                                                                      VerticalOptions="Center">

                                                                    <!-- Метка "Вы" для текущего пользователя -->
                                                                    <Label Text="Вы"
                                                                           Grid.Column="0"
                                                                           FontSize="12"
                                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                                                           VerticalOptions="Center"
                                                                           IsVisible="{Binding IsCurrentUser}"/>

                                                                    <!-- Кнопка профиля для других участников -->
                                                                    <Button Text="Профиль"
                                                                            Grid.Column="1"
                                                                            BackgroundColor="Transparent"
                                                                            TextColor="{StaticResource PrimaryColor}"
                                                                            FontSize="12"
                                                                            BorderWidth="1"
                                                                            BorderColor="{StaticResource PrimaryColor}"
                                                                            CornerRadius="6"
                                                                            Padding="12,4"
                                                                            HeightRequest="28"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                              Path=BindingContext.ViewMemberProfileCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            IsVisible="{Binding IsCurrentUser, Converter={StaticResource InvertedBoolConverter}}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Frame>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>

                                                <!-- Пустое пространство после списка участников -->
                                                <CollectionView.Footer>
                                                    <StackLayout HeightRequest="40"/>
                                                </CollectionView.Footer>
                                            </CollectionView>

                                            <!-- Дополнительное пространство в конце -->
                                            <BoxView HeightRequest="30" Color="Transparent"/>
                                        </VerticalStackLayout>

                                        <!-- ЗАПРОСЫ НА ВСТУПЛЕНИЕ -->
                                        <VerticalStackLayout IsVisible="{Binding IsRequests}" 
                                                             Spacing="16"
                                                             Padding="20,16,20,40">

                                            <!-- Состояние когда запросов нет -->
                                            <Frame IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                       Path=BindingContext.HasPendingRequests, 
                                                                       Converter={StaticResource InvertedBoolConverter}}"
                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                   CornerRadius="12"
                                                   Padding="20">
                                                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                                                    <Label Text="🎉"
                                                           FontSize="32"
                                                           HorizontalOptions="Center"/>

                                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                                        <Label Text="Новых запросов нет"
                                                               FontSize="16"
                                                               FontAttributes="Bold"    
                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                               HorizontalOptions="Center"/>

                                                        <Label Text="Все запросы на вступление будут отображаться здесь"
                                                               FontSize="14"
                                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                                               HorizontalOptions="Center"
                                                               VerticalTextAlignment="Center"/>
                                                    </VerticalStackLayout>

                                                    <Button Text="Поделиться приглашением"
                                                            BackgroundColor="{StaticResource PrimaryColor}"
                                                            TextColor="White"
                                                            CornerRadius="8"
                                                            Padding="24,12"
                                                            FontSize="14"
                                                            HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Список активных запросов -->
                                            <VerticalStackLayout IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                     Path=BindingContext.HasPendingRequests}" 
                                                                 Spacing="12"
                                                                 VerticalOptions="FillAndExpand">
                                                <Label Text="Запросы на вступление"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                                <CollectionView ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                      Path=BindingContext.PendingRequests}"
                                                                VerticalOptions="FillAndExpand">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:MembershipRequest">
                                                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                                   CornerRadius="12"
                                                                   Padding="16"
                                                                   Margin="0,0,0,12">
                                                                <VerticalStackLayout Spacing="8">

                                                                    <!-- Аватар и имя пользователя -->
                                                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                                                        <!-- Аватар -->
                                                                        <Frame WidthRequest="44"
                                                                               HeightRequest="44"
                                                                               CornerRadius="22"
                                                                               BackgroundColor="{StaticResource PrimaryColor}"
                                                                               Padding="0"
                                                                               VerticalOptions="Center">
                                                                            <Label Text="{Binding UserDisplayName, Converter={StaticResource FirstCharacterConverter}}"
                                                                                   TextColor="White"
                                                                                   FontSize="16"
                                                                                   FontAttributes="Bold"
                                                                                   HorizontalOptions="Center"
                                                                                   VerticalOptions="Center"/>
                                                                        </Frame>

                                                                        <!-- Имя пользователя -->
                                                                        <Label Text="{Binding UserDisplayName}"
                                                                               FontSize="16"
                                                                               FontAttributes="Bold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                                               VerticalOptions="Center"/>
                                                                    </HorizontalStackLayout>

                                                                    <!-- Дата создания -->
                                                                    <Label Text="{Binding CreatedAt, StringFormat='Запрос отправлен {0:dd.MM.yyyy в HH:mm}'}"
                                                                           FontSize="12"
                                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                                                           Margin="56,-15,0,10"/>

                                                                    <!-- Кнопки -->
                                                                    <HorizontalStackLayout Spacing="12" 
                                                                                           HorizontalOptions="Center"
                                                                                           Margin="0,0,0,0">
                                                                        <Button Text="Принять"
                                                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                                                TextColor="White"
                                                                                FontSize="14"
                                                                                FontAttributes="Bold"
                                                                                CornerRadius="8"
                                                                                Padding="24,10"
                                                                                HeightRequest="40"
                                                                                MinimumWidthRequest="100"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                                  Path=BindingContext.AcceptRequestCommand}"
                                                                                CommandParameter="{Binding}"/>

                                                                        <Button Text="Отклонить"
                                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray500}}"
                                                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                                                FontSize="14"
                                                                                FontAttributes="Bold"
                                                                                CornerRadius="8"
                                                                                Padding="24,10"
                                                                                HeightRequest="40"
                                                                                MinimumWidthRequest="100"
                                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                                                                  Path=BindingContext.RejectRequestCommand}"
                                                                                CommandParameter="{Binding}"/>
                                                                    </HorizontalStackLayout>
                                                                </VerticalStackLayout>
                                                            </Frame>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>

                                                    <!-- Пустое пространство после списка запросов -->
                                                    <CollectionView.Footer>
                                                        <StackLayout HeightRequest="40"/>
                                                    </CollectionView.Footer>
                                                </CollectionView>
                                            </VerticalStackLayout>

                                            <!-- История запросов -->
                                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                                   CornerRadius="12"
                                                   Padding="16">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="Последние действия"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                                    <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                                                        <BoxView WidthRequest="4"
                                                                 HeightRequest="40"
                                                                 BackgroundColor="#4CAF50"
                                                                 CornerRadius="2"
                                                                 VerticalOptions="Center"/>

                                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                            <Label Text="Петр принят в семью"
                                                                   FontSize="14"
                                                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
                                                            <Label Text="3 дня назад"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Дополнительное пространство в конце -->
                                            <BoxView HeightRequest="30" Color="Transparent"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Контент когда НЕТ семьи -->
            <VerticalStackLayout IsVisible="{Binding HasFamily, Converter={StaticResource InvertedBoolConverter}}"
                                Spacing="32"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Padding="40,100">

                <!-- Иконка -->
                <Label Text="👨‍👩‍👧‍👦"
                       FontSize="80"
                       HorizontalOptions="Center"/>

                <!-- Заголовок -->
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="Еще не вступили в семью?"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="Присоединитесь к существующей семье или создайте новую, чтобы начать делиться рецептами и планировать совместные обеды!"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           MaxLines="4"/>
                </VerticalStackLayout>

                <!-- Кнопки действий -->
                <VerticalStackLayout Spacing="16" HorizontalOptions="FillAndExpand">
                    <Button Text="Создать семью"
                            Command="{Binding CreateFamilyCommand}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="54"
                            HorizontalOptions="FillAndExpand"/>

                    <Button Text="Присоединиться к семье"
                            Command="{Binding JoinFamilyCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryColor}"
                            FontSize="16"
                            FontAttributes="Bold"
                            BorderWidth="2"
                            BorderColor="{StaticResource PrimaryColor}"
                            CornerRadius="12"
                            HeightRequest="54"
                            HorizontalOptions="FillAndExpand"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>