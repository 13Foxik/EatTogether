<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EatTogether.MAUI.ViewModels"
             xmlns:models="clr-namespace:EatTogether.MAUI.Models"
             x:Class="EatTogether.MAUI.Views.Main.MenuPage"
             x:DataType="vm:MenuViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}">

    <ContentPage.BindingContext>
        <vm:MenuViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, *">

        <!-- ШАПКА - С закругленными нижними краями, без полосы и с тонкой линией сверху -->
        <Border Grid.Row="0"
                IsVisible="{Binding HasFamily}"
                BackgroundColor="{StaticResource PrimaryColor}"
                StrokeShape="RoundRectangle 0,0,25,25"
                Padding="0"
                HeightRequest="160"
                StrokeThickness="0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="Start">
            <Border.Shadow>
                <Shadow Brush="{StaticResource PrimaryColor}"
                        Offset="0,10"
                        Radius="20"
                        Opacity="0.3"/>
            </Border.Shadow>
            <Grid>
                <!-- НОВАЯ: Тонкая белая линия перед шапкой -->
                <BoxView BackgroundColor="White"
                         HeightRequest="1"
                         VerticalOptions="Start"
                         HorizontalOptions="FillAndExpand"
                         Opacity="0.4"
                         Margin="0,0,0,0"/>
                <!-- Убедимся, что она прямо сверху -->

                <!-- Декоративный узор в углу -->
                <BoxView BackgroundColor="{StaticResource PrimaryDarkColor}"
                         Opacity="0.2"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         WidthRequest="120"
                         HeightRequest="120"
                         CornerRadius="60"
                         TranslationX="-60"
                         TranslationY="-60"/>

                <BoxView BackgroundColor="{StaticResource PrimaryDarkColor}"
                         Opacity="0.1"
                         HorizontalOptions="End"
                         VerticalOptions="End"
                         WidthRequest="100"
                         HeightRequest="100"
                         CornerRadius="50"
                         TranslationX="50"
                         TranslationY="50"/>

                <!-- Контент шапки -->
                <VerticalStackLayout Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <!-- Декоративная линия -->
                    <BoxView HeightRequest="3"
                           WidthRequest="40"
                           BackgroundColor="White"
                           HorizontalOptions="Center"
                           CornerRadius="2"
                           Opacity="0.8"/>

                    <!-- Заголовок -->
                    <Label Text="Меню семьи"
                         FontSize="28"
                         FontAttributes="Bold"
                         TextColor="White"
                         HorizontalOptions="Center"
                         HorizontalTextAlignment="Center"/>

                    <!-- Подзаголовок -->
                    <Label Text="Кулинарная коллекция вашей семьи"
                         FontSize="14"
                         TextColor="White"
                         Opacity="0.9"
                         HorizontalOptions="Center"
                         HorizontalTextAlignment="Center"/>

                    <!-- Декоративная линия -->
                    <BoxView HeightRequest="2"
                           WidthRequest="60"
                           BackgroundColor="White"
                           HorizontalOptions="Center"
                           CornerRadius="1"
                           Opacity="0.6"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="32">

                <!-- Заголовок когда нет семьи -->
                <VerticalStackLayout IsVisible="{Binding ShowNoFamilyMessage}"
                                    Spacing="8">
                    <Label Text="Меню"
                           Style="{StaticResource Headline}"
                           HorizontalOptions="Start"/>

                    <Label Text="Ваше семейное меню будет доступно после присоединения к семье"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                </VerticalStackLayout>

                <!-- Сообщение "НЕТ СЕМЬИ" -->
                <VerticalStackLayout IsVisible="{Binding ShowNoFamilyMessage}"
                                    Margin="0, -50, 0, 0"
                                    Spacing="32"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Padding="40,60">

                    <!-- Иконка -->
                    <Label Text="🍽️"
                         FontSize="80"
                         HorizontalOptions="Center"/>

                    <!-- Сообщение -->
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Label Text="Сначала присоединитесь к семье!"
                             FontSize="24"
                             FontAttributes="Bold"
                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                             HorizontalOptions="Center"
                             HorizontalTextAlignment="Center"/>

                        <Label Text="Вы сможете просматривать рецепты, планировать обеды и делиться своими кулинарными шедеврами с близкими!"
                             FontSize="16"
                             TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                             HorizontalOptions="Center"
                             HorizontalTextAlignment="Center"
                             MaxLines="5"/>
                    </VerticalStackLayout>

                    <!-- Кнопка перехода к семье -->
                    <Button Text="Перейти к семье"
                          BackgroundColor="{StaticResource PrimaryColor}"
                          TextColor="White"
                          FontSize="16"
                          FontAttributes="Bold"
                          CornerRadius="12"
                          HeightRequest="54"
                          HorizontalOptions="FillAndExpand"
                          Clicked="OnGoToFamilyClicked"/>

                </VerticalStackLayout>

                <!-- Индикатор загрузки (только когда есть семья) -->
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                 IsRunning="{Binding IsBusy}"
                                 Color="{StaticResource PrimaryColor}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 HeightRequest="50"/>

                <!-- Сообщение "НЕТ КАТЕГОРИЙ" (только когда есть семья) -->
                <Frame IsVisible="{Binding ShowNoCategoriesMessage}"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                     CornerRadius="16"
                     Padding="40"
                     Margin="0,20"
                     HorizontalOptions="FillAndExpand">

                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Label Text="📋"
                             FontSize="48"
                             HorizontalOptions="Center"/>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="Меню пока пустое"
                                 FontSize="20"
                                 FontAttributes="Bold"
                                 TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                 HorizontalOptions="Center"/>

                            <Label Text="Добавьте первые рецепты, чтобы создать ваше семейное меню"
                                 FontSize="14"
                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                 HorizontalOptions="Center"
                                 HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <Button Text="Создать первое блюдо"
                              Command="{Binding LoadCategoriesCommand}"
                              BackgroundColor="{StaticResource PrimaryColor}"
                              TextColor="White"
                              CornerRadius="8"
                              Padding="32,14"
                              FontSize="14"
                              FontAttributes="Bold"
                              HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ЗАГОЛОВОК КАТЕГОРИЙ С КНОПКОЙ НАСТРОЕК -->
                <Grid IsVisible="{Binding ShowCategoriesContent}"
                      HorizontalOptions="FillAndExpand"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок категорий с декоративными элементами -->
                    <VerticalStackLayout Grid.Column="0" Spacing="12" HorizontalOptions="Start">
                        <BoxView HeightRequest="1"
                               WidthRequest="80"
                               BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                               HorizontalOptions="Start"/>

                        <Label Text="Категории блюд"
                             FontSize="24"
                             FontAttributes="Bold"
                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                             HorizontalOptions="Start"/>
                    </VerticalStackLayout>

                    <!-- КНОПКА НАСТРОЕК В СТИЛЕ ПРЕМИУМ -->
                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                           CornerRadius="12"
                           Padding="0"
                           WidthRequest="44"
                           HeightRequest="44"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           HasShadow="True">

                        <Frame.GestureRecognizers>
                            <!--<TapGestureRecognizer Command="{Binding SettingsCommand}"/>-->
                        </Frame.GestureRecognizers>

                        <Grid>
                            <!-- Фон при нажатии -->
                            <BoxView BackgroundColor="{StaticResource PrimaryColor}"
                                   Opacity="0"
                                   x:Name="SettingsButtonBackground"/>

                            <!-- Иконка настроек -->
                            <Label Text="⚙️"
                                 FontSize="16"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </Grid>

                <!-- СЕТКА КАТЕГОРИЙ В ПРЕМИУМ СТИЛЕ -->
                <FlexLayout BindableLayout.ItemsSource="{Binding Categories}"
                          IsVisible="{Binding ShowCategoriesContent}"
                          Direction="Row"
                          Wrap="Wrap"
                          JustifyContent="SpaceBetween"
                          AlignItems="Start">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Category">
                            <!-- КЛИКАБЕЛЬНАЯ КАРТОЧКА КАТЕГОРИИ -->
                            <Frame WidthRequest="175"
                                 HeightRequest="220"
                                 Padding="0"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                 BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                                 CornerRadius="16"
                                 HasShadow="True"
                                 Margin="0,0,0,24">

                                

                                <!-- ОБРАБОТЧИК КЛИКА -->
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MenuViewModel}}, Path=CategoryTappedCommand}"
                                        CommandParameter="{Binding}"/>
                                </Frame.GestureRecognizers>

                                <Grid RowDefinitions="140,80"
                                    RowSpacing="0">

                                    <!-- Изображение категории с градиентом -->
                                    <Frame Grid.Row="0"
                                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                         CornerRadius="16"
                                         Padding="0"
                                         HorizontalOptions="Fill"
                                         VerticalOptions="Fill"
                                         InputTransparent="True">

                                        <Grid>
                                            <!-- Градиентный оверлей -->
                                            <BoxView BackgroundColor="{StaticResource PrimaryColor}"
                                                   Opacity="0.03"
                                                   HorizontalOptions="Fill"
                                                   VerticalOptions="Fill"
                                                   InputTransparent="True"/>

                                            <!-- Иконка категории в элегантном стиле -->
                                            <VerticalStackLayout Spacing="12"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"
                                                               Padding="20"
                                                               InputTransparent="True">
                                                <Frame BackgroundColor="{StaticResource PrimaryColor}"
                                                       Opacity="0.1"
                                                       CornerRadius="12"
                                                       Padding="12"
                                                       WidthRequest="48"
                                                       HeightRequest="48"
                                                       HorizontalOptions="Center">
                                                    <Label Text="{Binding Icon}"
                                                         FontSize="20"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         TextColor="{StaticResource PrimaryColor}"/>
                                                </Frame>
                                            </VerticalStackLayout>

                                            <!-- Бейдж количества рецептов -->
                                            <Frame BackgroundColor="{StaticResource PrimaryColor}"
                                                 CornerRadius="10"
                                                 Padding="8,4"
                                                 HorizontalOptions="End"
                                                 VerticalOptions="Start"
                                                 Margin="8"
                                                 HeightRequest="24"
                                                 HasShadow="True">
                                                <Frame.Shadow>
                                                    <Shadow Brush="{StaticResource PrimaryColor}"
                                                          Offset="0,2"
                                                          Radius="4"
                                                          Opacity="0.3"/>
                                                </Frame.Shadow>
                                                <Label Text="13"
                                                     FontSize="11"
                                                     TextColor="White"
                                                     FontAttributes="Bold"/>
                                            </Frame>
                                        </Grid>
                                    </Frame>

                                    <!-- Название категории -->
                                    <VerticalStackLayout Grid.Row="1"
                                                       Padding="16,14"
                                                       Spacing="8"
                                                       VerticalOptions="Center">

                                        <Label Text="{Binding Name}"
                                             FontSize="16"
                                             FontAttributes="Bold"
                                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                             HorizontalOptions="Center"
                                             HorizontalTextAlignment="Center"
                                             MaxLines="2"
                                             LineBreakMode="TailTruncation"/>

                                        <!-- Декоративный разделитель с акцентом -->
                                        <BoxView HeightRequest="2"
                                               WidthRequest="32"
                                               BackgroundColor="{StaticResource PrimaryColor}"
                                               HorizontalOptions="Center"
                                               CornerRadius="1"
                                               Opacity="0.7"/>

                                        <Label Text="13"
                                             FontSize="12"
                                             TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                             HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- СТАТИСТИКА И ДОПОЛНИТЕЛЬНАЯ ИНФОРМАЦИЯ -->
                <Grid IsVisible="{Binding ShowCategoriesContent}"
                      Margin="0,20"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="16">

                    <!-- Общее количество рецептов -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Всего рецептов"
                                 FontSize="12"
                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                 HorizontalOptions="Start"/>
                            <Label Text="15"
                                 FontSize="20"
                                 FontAttributes="Bold"
                                 TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark=White}"
                                 HorizontalOptions="Start"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Популярная категория -->
                    <Frame Grid.Column="1"
                           BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Самая популярная"
                                 FontSize="12"
                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                 HorizontalOptions="Start"/>
                            <Label Text="Мясо"
                                 FontSize="14"
                                 FontAttributes="Bold"
                                 TextColor="{StaticResource PrimaryColor}"
                                 HorizontalOptions="Start"/>
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>