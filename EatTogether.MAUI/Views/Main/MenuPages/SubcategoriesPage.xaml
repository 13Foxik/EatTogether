<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EatTogether.MAUI.ViewModels"
             xmlns:models="clr-namespace:EatTogether.MAUI.Models"
             xmlns:helpers="clr-namespace:EatTogether.MAUI.Helpers"
             x:Class="EatTogether.MAUI.Views.Main.MenuPages.SubcategoriesPage"
             x:DataType="vm:SubcategoriesViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Конвертер для стрелки -->
            <helpers:BoolToArrowConverter x:Key="BoolToArrowConverter"/>

            <!-- Конвертер для проверки количества -->
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <helpers:IntToInverseBoolConverter x:Key="IntToInverseBoolConverter"/>

            <!-- Конвертер для инвертирования bool -->
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <!-- Конвертеры для тарелки -->
            <helpers:BoolToInPlateTextConverter x:Key="InPlateButtonTextConverter"/>
            <helpers:BoolToInPlateButtonBackgroundColorConverter x:Key="InPlateButtonBackgroundColorConverter"/>
            <helpers:BoolToInPlateButtonBorderColorConverter x:Key="InPlateButtonBorderColorConverter"/>
            <helpers:BoolToInPlateButtonTextColorConverter x:Key="InPlateButtonTextColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ШАПКА С НАЗВАНИЕМ КАТЕГОРИИ -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource PrimaryColor}"
                StrokeShape="RoundRectangle 0,0,25,25"
                Padding="0"
                HeightRequest="140"
                StrokeThickness="0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="Start">

            <Border.Shadow>
                <Shadow Brush="{StaticResource PrimaryColor}"
                        Offset="0,10"
                        Radius="20"
                        Opacity="0.3"/>
            </Border.Shadow>

            <Grid>
                <!-- Декоративный узор -->
                <BoxView BackgroundColor="{StaticResource PrimaryDarkColor}"
                         Opacity="0.2"
                         HorizontalOptions="Start"
                         VerticalOptions="Start"
                         WidthRequest="100"
                         HeightRequest="100"
                         CornerRadius="50"
                         TranslationX="-50"
                         TranslationY="-50"/>

                <BoxView BackgroundColor="{StaticResource PrimaryDarkColor}"
                         Opacity="0.1"
                         HorizontalOptions="End"
                         VerticalOptions="End"
                         WidthRequest="80"
                         HeightRequest="80"
                         CornerRadius="40"
                         TranslationX="40"
                         TranslationY="40"/>

                <!-- Контент шапки -->
                <Grid ColumnDefinitions="Auto, *, Auto" Padding="20,0">

                    <!-- Кнопка назад -->
                    <Frame Grid.Column="0"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                           CornerRadius="10"
                           Padding="0"
                           WidthRequest="36"
                           HeightRequest="36"
                           HorizontalOptions="Start"
                           VerticalOptions="Center"
                           HasShadow="True">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </Frame.GestureRecognizers>

                        <Label Text="←"
                             FontSize="16"
                             TextColor="{StaticResource PrimaryColor}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    </Frame>

                    <!-- Название категории -->
                    <VerticalStackLayout Grid.Column="1"
                                       Spacing="6"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">

                        <Label Text="{Binding CategoryName}"
                             FontSize="22"
                             FontAttributes="Bold"
                             TextColor="White"
                             HorizontalOptions="Center"
                             HorizontalTextAlignment="Center"/>

                        <Label Text="Подкатегории"
                             FontSize="14"
                             TextColor="White"
                             Opacity="0.9"
                             HorizontalOptions="Center"
                             HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Кнопка настроек -->
                    <Frame Grid.Column="2"
                           BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                           CornerRadius="10"
                           Padding="0"
                           WidthRequest="36"
                           HeightRequest="36"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           HasShadow="True"
                           Opacity="0.8">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SettingsCommand}"/>
                        </Frame.GestureRecognizers>

                        <Label Text="⚙️"
                             FontSize="14"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    </Frame>
                </Grid>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="24">

                <!-- Индикатор загрузки -->
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                 IsRunning="{Binding IsBusy}"
                                 Color="{StaticResource PrimaryColor}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 HeightRequest="50"/>

                <!-- Сообщение "НЕТ ПОДКАТЕГОРИЙ" -->
                <Frame IsVisible="{Binding ShowNoSubcategoriesMessage}"
                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                     CornerRadius="16"
                     Padding="40"
                     Margin="0,20"
                     HorizontalOptions="FillAndExpand">

                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Label Text="📂"
                             FontSize="48"
                             HorizontalOptions="Center"/>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="Подкатегории пока отсутствуют"
                                 FontSize="18"
                                 FontAttributes="Bold"
                                 TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                 HorizontalOptions="Center"/>

                            <Label Text="Здесь будут отображаться подкатегории для выбранной категории"
                                 FontSize="14"
                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                                 HorizontalOptions="Center"
                                 HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <Button Text="Создать первую подкатегорию"
                              Command="{Binding CreateSubcategoryCommand}"
                              BackgroundColor="{StaticResource PrimaryColor}"
                              TextColor="White"
                              CornerRadius="8"
                              Padding="32,14"
                              FontSize="14"
                              FontAttributes="Bold"
                              HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- ЗАГОЛОВОК ПОДКАТЕГОРИЙ -->
                <Grid IsVisible="{Binding ShowSubcategoriesContent}"
                      HorizontalOptions="FillAndExpand"
                      Margin="0,0,0,16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Заголовок с декоративными элементами -->
                    <VerticalStackLayout Grid.Column="0" Spacing="12" HorizontalOptions="Start">
                        <BoxView HeightRequest="1"
                               WidthRequest="80"
                               BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                               HorizontalOptions="Start"/>

                        <Label Text="Подкатегории"
                             FontSize="24"
                             FontAttributes="Bold"
                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                             HorizontalOptions="Start"/>

                        <Label Text="{Binding SubcategoriesCount, StringFormat='{0} подкатегорий'}"
                             FontSize="14"
                             TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                             HorizontalOptions="Start"/>
                    </VerticalStackLayout>

                    <!-- КНОПКИ ДОБАВЛЕНИЯ И УПРАВЛЕНИЯ -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">

                        <!-- Кнопка добавления блюда -->
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               HasShadow="True">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddDishCommand}"/>
                            </Frame.GestureRecognizers>

                            <Grid>
                                <Label Text="🍽️"
                                     FontSize="16"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                            </Grid>
                        </Frame>

                        <!-- Кнопка добавления подкатегории -->
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}"
                               BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                               CornerRadius="12"
                               Padding="0"
                               WidthRequest="44"
                               HeightRequest="44"
                               HorizontalOptions="End"
                               VerticalOptions="Center"
                               HasShadow="True">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreateSubcategoryCommand}"/>
                            </Frame.GestureRecognizers>

                            <Grid>
                                <Label Text="➕"
                                     FontSize="16"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </HorizontalStackLayout>
                </Grid>

                <!-- АККОРДЕОН ПОДКАТЕГОРИЙ -->
                <VerticalStackLayout IsVisible="{Binding ShowSubcategoriesContent}"
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding Subcategories}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Subcategory">

                            <!-- КАРТОЧКА ПОДКАТЕГОРИИ С АККОРДЕОНОМ -->
                            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                   BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                                   CornerRadius="16"
                                   Padding="0"
                                   HasShadow="True">

                                <Frame.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light={StaticResource Gray200}, Dark=Black}"
                                      Offset="0,4"
                                      Radius="8"
                                      Opacity="0.1"/>
                                </Frame.Shadow>

                                <VerticalStackLayout Spacing="0">

                                    <!-- ЗАГОЛОВОК ПОДКАТЕГОРИИ (кликабельный) -->
                                    <Grid Padding="20,16"
                                          ColumnDefinitions="*, Auto, Auto, Auto"
                                          BackgroundColor="Transparent">

                                        <!-- ОБЩИЙ КЛИК ПО ВСЕЙ СТРОКЕ -->
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=ToggleSubcategoryCommand}"
                                                CommandParameter="{Binding}"/>
                                        </Grid.GestureRecognizers>

                                        <!-- Название подкатегории и количество блюд -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="{Binding Name}"
                                                 FontSize="18"
                                                 FontAttributes="Bold"
                                                 TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                            <Label Text="{Binding Dishes.Count, StringFormat='{0} блюд'}"
                                                 FontSize="13"
                                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"/>
                                        </VerticalStackLayout>

                                        <!-- Кнопка редактирования подкатегории -->
                                        <Frame Grid.Column="1"
                                               BackgroundColor="Transparent"
                                               BorderColor="Transparent"
                                               Padding="0"
                                               WidthRequest="32"
                                               HeightRequest="32"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0">

                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=EditSubcategoryCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Frame.GestureRecognizers>

                                            <Label Text="✎"
                                                 FontSize="12"
                                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                        </Frame>

                                        <!-- Кнопка удаления подкатегории -->
                                        <Frame Grid.Column="2"
                                               BackgroundColor="Transparent"
                                               BorderColor="Transparent"
                                               Padding="0"
                                               WidthRequest="32"
                                               HeightRequest="32"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               Margin="0,0,12,0">

                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=DeleteSubcategoryCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Frame.GestureRecognizers>

                                            <Label Text="🗑️"
                                                 FontSize="12"
                                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"/>
                                        </Frame>

                                        <!-- СТРЕЛКА ДЛЯ РАСКРЫТИЯ (тоже кликабельная) -->
                                        <Label Grid.Column="3"
                                               Text="{Binding IsExpanded, Converter={x:StaticResource BoolToArrowConverter}}"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                               VerticalOptions="Center"
                                               HorizontalOptions="End">

                                            <!-- Делаем стрелку тоже кликабельной -->
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=ToggleSubcategoryCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Label.GestureRecognizers>
                                        </Label>

                                    </Grid>

                                    <!-- РАЗДЕЛИТЕЛЬ -->
                                    <BoxView HeightRequest="1"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                                        Margin="20,0"
                                        IsVisible="{Binding IsExpanded}"/>

                                    <!-- ВЫПАДАЮЩИЙ СПИСОК БЛЮД -->
                                    <VerticalStackLayout Padding="20,12,20,20"
                                       Spacing="8"
                                       IsVisible="{Binding IsExpanded}">

                                        <!-- КНОПКА ДОБАВЛЕНИЯ БЛЮДА -->
                                        <Frame IsVisible="{Binding IsAddingDish, Converter={x:StaticResource InverseBoolConverter}}"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource PrimaryDarkColor}}"
                                             CornerRadius="12"
                                             Padding="0"
                                             HasShadow="False">

                                            <Frame.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=StartAddingDishCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Frame.GestureRecognizers>

                                            <Grid Padding="16,12" ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0"
                                                     Text="Добавить блюдо"
                                                     FontSize="15"
                                                     FontAttributes="Bold"
                                                     TextColor="White"
                                                     VerticalOptions="Center"/>

                                                <Label Grid.Column="1"
                                                     Text="+"
                                                     FontSize="18"
                                                     FontAttributes="Bold"
                                                     TextColor="White"
                                                     VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>

                                        <!-- ФОРМА ДОБАВЛЕНИЯ БЛЮДА -->
                                        <Frame IsVisible="{Binding IsAddingDish}" 
                                                 BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                                 CornerRadius="12"
                                                 Padding="16"
                                                 HasShadow="False">

                                            <VerticalStackLayout Spacing="12">
                                                <Label Text="Новое блюдо"
                                                     FontSize="14"
                                                     FontAttributes="Bold"
                                                     TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                                                <Entry Text="{Binding NewDishName}"
                                                        Placeholder="Введите название блюда..."
                                                        FontSize="15"
                                                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray700}}"
                                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark=White}"
                                                        PlaceholderColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                                        ClearButtonVisibility="WhileEditing"
                                                        HeightRequest="44"/>

                                                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                                    <Button Grid.Column="0"
                                                          Text="Отмена"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=CancelAddingDishCommand}"
                                                          CommandParameter="{Binding}"
                                                          BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                                          TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark=White}"
                                                          CornerRadius="8"
                                                          HeightRequest="36"
                                                          FontSize="13"/>

                                                    <Button Grid.Column="1"
                                                          Text="Добавить"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=AddDishCommand}"
                                                          CommandParameter="{Binding}"
                                                          BackgroundColor="{StaticResource PrimaryColor}"
                                                          TextColor="White"
                                                          CornerRadius="8"
                                                          HeightRequest="36"
                                                          FontSize="13"
                                                          FontAttributes="Bold"/>
                                                </Grid>
                                            </VerticalStackLayout>
                                        </Frame>

                                        <!-- СООБЩЕНИЕ ЕСЛИ НЕТ БЛЮД -->
                                        <Frame IsVisible="{Binding Dishes.Count, Converter={x:StaticResource IntToInverseBoolConverter}}"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}"
                                             CornerRadius="12"
                                             Padding="16,12"
                                             HasShadow="False">
                                            <Label Text="Блюда пока не добавлены"
                                                 FontSize="14"
                                                 TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray400}}"
                                                 HorizontalOptions="Center"/>
                                        </Frame>

                                        <!-- СПИСОК БЛЮД -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dishes}"
                                               Spacing="6"
                                               IsVisible="{Binding Dishes.Count, Converter={x:StaticResource IntToBoolConverter}}">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:Dish">
                                                    <!-- КАРТОЧКА БЛЮДА С КНОПКАМИ УПРАВЛЕНИЯ -->
                                                    <Frame BackgroundColor="{Binding IsInPlate, Converter={x:StaticResource BoolToBackgroundColorConverter}}"
                                                           CornerRadius="12"
                                                           Padding="0"
                                                           HasShadow="False">

                                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto"
                                                              Padding="12,8">

                                                            <!-- Название блюда -->
                                                            <Label Grid.Column="0"
                                                                 Text="{Binding Name}"
                                                                 FontSize="15"
                                                                 TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                                                 VerticalOptions="Center"
                                                                 Margin="8,0,0,0"/>

                                                            <!-- Кнопка добавления/удаления из тарелки -->
                                                            <Frame Grid.Column="1"
                                                                   BackgroundColor="{Binding IsInPlate, Converter={x:StaticResource InPlateButtonBackgroundColorConverter}}"
                                                                   BorderColor="{Binding IsInPlate, Converter={x:StaticResource InPlateButtonBorderColorConverter}}"
                                                                   CornerRadius="8"
                                                                   Padding="0"
                                                                   WidthRequest="36"
                                                                   HeightRequest="36"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center"
                                                                   Margin="0,0,8,0">

                                                                <Frame.GestureRecognizers>
                                                                    <TapGestureRecognizer 
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=TogglePlateCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                </Frame.GestureRecognizers>

                                                                <Label Text="{Binding IsInPlate, Converter={x:StaticResource InPlateButtonTextConverter}}"
                                                                     FontSize="12"
                                                                     FontAttributes="Bold"
                                                                     TextColor="{Binding IsInPlate, Converter={x:StaticResource InPlateButtonTextColorConverter}}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"/>
                                                            </Frame>

                                                            <!-- Кнопка редактирования -->
                                                            <Frame Grid.Column="2"
                                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Blue100}, Dark={StaticResource Blue900}}"
                                                                   BorderColor="{AppThemeBinding Light={StaticResource Blue300}, Dark={StaticResource Blue700}}"
                                                                   CornerRadius="8"
                                                                   Padding="0"
                                                                   WidthRequest="36"
                                                                   HeightRequest="36"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center"
                                                                   Margin="0,0,8,0">

                                                                <Frame.GestureRecognizers>
                                                                    <TapGestureRecognizer 
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=EditDishCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                </Frame.GestureRecognizers>

                                                                <Label Text="✎"
                                                                     FontSize="12"
                                                                     FontAttributes="Bold"
                                                                     TextColor="{AppThemeBinding Light={StaticResource Blue600}, Dark={StaticResource Blue200}}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"/>
                                                            </Frame>

                                                            <!-- Кнопка удаления -->
                                                            <Frame Grid.Column="3"
                                                                   BackgroundColor="{AppThemeBinding Light={StaticResource Red100}, Dark={StaticResource Red900}}"
                                                                   BorderColor="{AppThemeBinding Light={StaticResource Red300}, Dark={StaticResource Red700}}"
                                                                   CornerRadius="8"
                                                                   Padding="0"
                                                                   WidthRequest="36"
                                                                   HeightRequest="36"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center">

                                                                <Frame.GestureRecognizers>
                                                                    <TapGestureRecognizer 
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SubcategoriesViewModel}}, Path=DeleteDishCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                                </Frame.GestureRecognizers>

                                                                <Label Text="✕"
                                                                     FontSize="12"
                                                                     FontAttributes="Bold"
                                                                     TextColor="{AppThemeBinding Light={StaticResource Red600}, Dark={StaticResource Red200}}"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center"/>
                                                            </Frame>
                                                        </Grid>
                                                    </Frame>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>

                                        </VerticalStackLayout>

                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Frame>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ПЛАВАЮЩАЯ ПАНЕЛЬ ТАРЕЛКИ -->
        <Border Grid.Row="2"
                IsVisible="{Binding ShowPlatePanel}"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}"
                StrokeShape="RoundRectangle 25,25,0,0"
                StrokeThickness="0"
                HorizontalOptions="FillAndExpand"
                VerticalOptions="End"
                Padding="0"
                HeightRequest="80"
                Margin="0">

            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="0,-5"
                        Radius="20"
                        Opacity="0.2"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, Auto" Padding="20,0" HorizontalOptions="FillAndExpand">

                <!-- Информация о тарелке -->
                <HorizontalStackLayout Grid.Column="0" 
                                     Spacing="12" 
                                     VerticalOptions="Center">

                    <!-- Иконка тарелки -->
                    <Frame BackgroundColor="{StaticResource PrimaryColor}"
                           CornerRadius="10"
                           Padding="0"
                           WidthRequest="44"
                           HeightRequest="44"
                           HorizontalOptions="Start"
                           VerticalOptions="Center">

                        <Label Text="🍽️"
                             FontSize="20"
                             TextColor="White"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    </Frame>

                    <!-- Текст с количеством блюд -->
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="Ваша тарелка"
                             FontSize="16"
                             FontAttributes="Bold"
                             TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark=White}"
                             HorizontalOptions="Start"/>

                        <Label Text="{Binding DishesInPlateCount, StringFormat='{0} блюд'}"
                             FontSize="14"
                             TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"
                             HorizontalOptions="Start"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Кнопка просмотра и управления -->
                <HorizontalStackLayout Grid.Column="1" 
                                     Spacing="12" 
                                     VerticalOptions="Center">

                    <!-- Кнопка очистки тарелки -->
                    <Frame BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                           BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                           CornerRadius="10"
                           Padding="0"
                           WidthRequest="44"
                           HeightRequest="44"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           HasShadow="True">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearPlateCommand}"/>
                        </Frame.GestureRecognizers>

                        <Label Text="🗑️"
                             FontSize="16"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
                    </Frame>

                    <!-- Кнопка перехода к тарелке -->
                    <Frame BackgroundColor="{StaticResource PrimaryColor}"
                           CornerRadius="10"
                           Padding="16,10"
