<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:EatTogether.MAUI.Behaviors"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EatTogether.MAUI.Views.Main.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Label Text="Профиль" 
                       Style="{StaticResource Headline}"
                       HorizontalOptions="Start"/>

                <Frame Padding="16"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                       CornerRadius="12"
                       HasShadow="True">

                    <HorizontalStackLayout Spacing="16">
                        <BoxView WidthRequest="60"
                                 HeightRequest="60"
                                 CornerRadius="30"
                                 BackgroundColor="{StaticResource PrimaryColor}"
                                 HorizontalOptions="Start"/>

                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding FirstName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
                                <Label Text="{Binding LastName}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
                            </HorizontalStackLayout>

                            <Label Text="{Binding DisplayName}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="16">
                <Label Text="Основная информация"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                <Grid ColumnDefinitions="Auto,1*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                    <Label Text="Дата регистрации:"
                           Grid.Row="0" Grid.Column="0"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                    <Label Text="{Binding FormattedCreatedAt}" 
                        Grid.Row="0" Grid.Column="1"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                           HorizontalOptions="End"/>

                    <Label Text="День рождения:"
                           Grid.Row="1" Grid.Column="0"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                    <Label Text="{Binding FormattedDateOfBirth}"
                            Grid.Row="1" Grid.Column="1"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                           HorizontalOptions="End"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Активность -->
            <VerticalStackLayout Spacing="16">
                <Label Text="Активность"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                <Frame Padding="16"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                       BorderColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"
                       CornerRadius="12">

                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                            <Label Text="Голосов в этом месяце:"
                                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                            <Label Text="47"
                                   Grid.Column="1"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                   HorizontalOptions="End"/>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource Gray600}}"/>

                        <Grid ColumnDefinitions="Auto,1*" ColumnSpacing="12">
                            <Label Text="Любимое блюдо:"
                                   TextColor="{AppThemeBinding Light={StaticResource SecondaryTextColor}, Dark={StaticResource Gray300}}"/>
                            <Label Text="Пока что нет информации"
                                   Grid.Column="1"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                                   HorizontalOptions="End"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Настройки -->
            <Button Text="Настройки"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"
                    CornerRadius="8"
                    HorizontalOptions="Fill"/>
            <Button Text="Выйти из аккаунта"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                        BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HorizontalOptions="Fill"
                        Margin="0,-10,0,30"
                        Command="{Binding SignOutCommand}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
