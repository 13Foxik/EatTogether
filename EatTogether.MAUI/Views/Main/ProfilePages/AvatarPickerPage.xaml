<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EatTogether.MAUI.ViewModels"
             xmlns:converters="clr-namespace:EatTogether.MAUI.Converters"
             x:Class="EatTogether.MAUI.Views.Main.ProfilePages.AvatarPickerPage"
             x:DataType="vm:AvatarPickerViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundColor}, Dark={StaticResource OffBlack}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:AvatarKeyToImageSourceConverter x:Key="AvatarImage"/>
            <converters:StringToColorConverter x:Key="StringToColor"/>
            <converters:InvertedBoolConverter x:Key="InvertedBool"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Шапка с кнопкой Назад -->
            <Grid Padding="12,16,12,8"
                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="← Назад"
                        Command="{Binding GoBackCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        TextColor="{StaticResource PrimaryColor}"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="34"
                        Padding="8,0"
                        HorizontalOptions="Start"/>

                <Label Grid.Column="1"
                       Text="Аватар"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
            </Grid>

            <VerticalStackLayout Padding="20,8,20,20" Spacing="20">

                <!-- Текущий аватар -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border WidthRequest="90"
                            HeightRequest="90"
                            StrokeThickness="0"
                            BackgroundColor="{Binding CurrentAvatarColor, Converter={StaticResource StringToColor}}"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <Ellipse/>
                        </Border.StrokeShape>
                        <Grid>
                            <Label IsVisible="{Binding HasNoCurrentAvatar}"
                                   Text="?"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Image IsVisible="{Binding HasCurrentAvatar}"
                                   Source="{Binding CurrentAvatarKey, Converter={StaticResource AvatarImage}}"
                                   Aspect="AspectFit"
                                   Margin="10"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Выбор цвета фона -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Цвет фона"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                    <CollectionView ItemsSource="{Binding Colors}"
                                    SelectionMode="None"
                                    HeightRequest="52">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AvatarColorChoice">
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="3"
                                        Stroke="{Binding IsSelected, Converter={StaticResource InvertedBool}, ConverterParameter=stroke}"
                                        BackgroundColor="{Binding HexColor, Converter={StaticResource StringToColor}}">
                                    <Border.StrokeShape>
                                        <Ellipse/>
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AvatarPickerViewModel}}, Path=SelectColorCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <Label IsVisible="{Binding IsSelected}"
                                           Text="✓"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Выбор аватара -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Выбери аватар"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>

                    <CollectionView ItemsSource="{Binding Avatars}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="3"
                                             HorizontalItemSpacing="12"
                                             VerticalItemSpacing="12"/>
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AvatarChoice">
                                <Border Padding="8"
                                        StrokeThickness="{Binding IsSelected, Converter={StaticResource InvertedBool}, ConverterParameter=thickness}"
                                        Stroke="{StaticResource PrimaryColor}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                        StrokeShape="RoundRectangle 16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AvatarPickerViewModel}}, Path=SelectAvatarCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <Border WidthRequest="72"
                                                HeightRequest="72"
                                                StrokeThickness="0"
                                                BackgroundColor="{StaticResource PrimaryColor}">
                                            <Border.StrokeShape>
                                                <Ellipse/>
                                            </Border.StrokeShape>
                                            <Image Source="{Binding Key, Converter={StaticResource AvatarImage}}"
                                                   Aspect="AspectFit"
                                                   Margin="8"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <Label Text="{Binding DisplayName}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextColor}, Dark={StaticResource White}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Кнопка сохранить -->
                <Button Text="Сохранить"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="10"
                        HeightRequest="48"
                        HorizontalOptions="Fill"
                        Command="{Binding SaveCommand}"
                        Margin="0,8,0,0"/>

                <!-- Кнопка сброса -->
                <Button Text="Сбросить аватар"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                        BorderColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HorizontalOptions="Fill"
                        Command="{Binding ClearAvatarCommand}"
                        Margin="0,0,0,32"/>

                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource PrimaryColor}"
                                   HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
