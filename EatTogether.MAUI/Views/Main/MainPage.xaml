<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:local="clr-namespace:EatTogether.MAUI.Views.Main"
            x:Class="EatTogether.MAUI.Views.Main.MainPage"
            BarBackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
            BarTextColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource White}}"
            UnselectedTabColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
            SelectedTabColor="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource White}}">

    <!-- Семья -->
    <local:FamilyPage Title =""  IconImageSource="family.png"/>

    <!-- Главное меню -->
    <local:MenuPage Title =""  IconImageSource="menu.png"/>

    <!-- Профиль -->
    <local:ProfilePage Title =""  IconImageSource="profile.png"/>

</TabbedPage>